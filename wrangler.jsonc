{
  "name": "settleupcli",
  "pages_build_output_dir": "./docs",
  "compatibility_date": "2026-05-28",
  "d1_databases": [{
    "binding": "LOGIN_DB",
    "database_name": "settleup-browser-login",
    "database_id": "58edb2f6-ca01-4afa-9042-7ea4ec78d495",
    "migrations_dir": "migrations"
  }],
  // Preview deployments run unreviewed branches on public URLs. They must never
  // write to the production handoff database. Credentials go directly to Firebase.
  "env": {
    "preview": {
      "d1_databases": [{
        "binding": "LOGIN_DB",
        "database_name": "settleup-browser-login-staging",
        "database_id": "f6c9e8b8-d062-4691-806b-6042fc7c1df5",
        "migrations_dir": "migrations"
      }]
    }
  }
}
