{
  "name": "settle-up-cli",
  "version": "0.1.1",
  "description": "A JSON-first Settle Up CLI for people and AI agents: groups, expenses, transfers, and debts.",
  "license": "MIT",
  "author": "Anshul Ravikumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewDae/settle-up-cli.git"
  },
  "homepage": "https://settleupcli.pages.dev/",
  "bugs": { "url": "https://github.com/NewDae/settle-up-cli/issues" },
  "engines": { "node": ">=22" },
  "keywords": ["settleup", "cli", "expenses", "split-bills", "agents"],
  "files": ["bin/", "README.md", "LOGIN.md", "AGENT_GUIDE.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": {
    "settleup": "./bin/settleup.mjs"
  },
  "scripts": {
    "test": "node --test test/cli-*.test.mjs test/negative-inputs.test.mjs test/spec-contracts.test.mjs",
    "test:live": "SETTLEUP_RUN_LIVE=1 node --test test/sandbox-live.test.mjs",
    "test:all": "node --test test/*.test.mjs",
    "integration:e2e": "node scripts/run-cli-integration.mjs",
    "integration:e2e:staging": "SETTLEUP_ENV_FILE=.env.staging node scripts/run-cli-integration.mjs",
    "integration:e2e:prod": "SETTLEUP_ENV_FILE=.env.production node scripts/run-cli-integration.mjs"
  }
}
